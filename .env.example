# Copy to .env for local development. Never commit .env.
# In production these are set as environment variables in Coolify.

PORT=3001

# Postgres. Locally this matches docker-compose.yml; in production use the
# internal connection string from the Coolify Postgres resource.
DATABASE_URL=postgres://tanush:localdev@127.0.0.1:5432/tanushchauhan

# WebAuthn. Passkeys are bound to the origin they were registered on, so a
# credential created against localhost will NOT work on tanushchauhan.com.
# Production: RP_ID=tanushchauhan.com  ORIGIN=https://tanushchauhan.com
RP_ID=localhost
ORIGIN=http://localhost:5173

# Signing key for session cookies. Generate with: openssl rand -base64 32
# Also salts the guestbook IP hashes, so rotating it signs everyone out AND
# orphans existing hashes. Without it, login is disabled and the server says so
# on startup; the public site keeps working.
SESSION_SECRET=replace-me

# Set to true when running behind a proxy (Coolify/Traefik, Cloudflare) so the
# rate limiter reads the caller's address from the proxy headers instead of
# bucketing every visitor together. Leave unset locally.
TRUST_PROXY=false

# Optional: read-only token used server-side to cache public GitHub stats.
# Never expose this to the client bundle.
GITHUB_TOKEN=
